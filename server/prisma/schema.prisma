// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  FOOD_COURT_ADMIN
  RESTAURANT_VENDOR
}

model FoodCourt {
  id          Int          @id @default(autoincrement())
  name        String
  location    String?
  createdAt   DateTime     @default(now())
  currancy    String       @default("USD")
  restaurants Restaurant[]
  admins      User[]
  tables      Table[]
}

model Table {
  id          Int        @id @default(autoincrement())
  number      String
  occupacy    Int
  shape       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  foodCourt   FoodCourt? @relation(fields: [foodCourtId], references: [id])
  foodCourtId Int?

  @@unique([foodCourtId, number])
}

model Restaurant {
  id          Int        @id @default(autoincrement())
  name        String
  location    String
  createdAt   DateTime   @default(now())
  foodCourtId Int
  foodCourt   FoodCourt  @relation(fields: [foodCourtId], references: [id])
  vendors     User[]
  menus       Menu[]
  categories  Category[]
  isClosed    Boolean    @default(false)
  orders      Order[]
}

model User {
  id                    Int         @id @default(autoincrement())
  name                  String
  email                 String      @unique
  password              String
  role                  Role
  createdAt             DateTime    @default(now())
  foodCourtId           Int?
  foodCourt             FoodCourt?  @relation(fields: [foodCourtId], references: [id])
  restaurantId          Int?
  restaurant            Restaurant? @relation(fields: [restaurantId], references: [id])
  logo                  String?
  restaurantDescription String?
}

model Menu {
  id           Int         @id @default(autoincrement())
  image        String
  itemName     String
  price        Int
  cost         Int
  quantity     Int
  description  String
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  category     Category?   @relation(fields: [categoryId], references: [id])
  categoryId   Int?
  orderItems   OrderItem[]
}

model Category {
  id           Int         @id @default(autoincrement())
  name         String
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  menus        Menu[]
}

model Order {
  id           Int         @id @default(autoincrement())
  totalAmount  Int
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  restaurantId Int
  tableName    Int
  tableNumber  Int
  restarant    Restaurant  @relation(fields: [restaurantId], references: [id])
  items        OrderItem[]
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  quantity Int
  price    Int
  order    Order? @relation(fields: [orderId], references: [id])
  orderId  Int?
  menuId   Int
  menu     Menu   @relation(fields: [menuId], references: [id])
}
